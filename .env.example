# Booth — QoreChain testnet (qorechain-diana, EVM chain id 9800)
#
# Copy to .env and fill in. NEVER commit .env. Testnet only.
# `node scripts/generate-accounts.mjs` creates all nine accounts and writes
# them here for you, printing only addresses — never a mnemonic.

# --- Network (verified values; see docs/VERIFIED-FACTS.md) ---
QORECHAIN_CHAIN_ID=qorechain-diana
QORECHAIN_EVM_CHAIN_ID=9800
QORECHAIN_REST=https://api-testnet.qore.host
QORECHAIN_RPC=https://rpc-testnet.qore.host
QORECHAIN_EVM_RPC=https://evm-testnet.qore.host
QORECHAIN_EXPLORER=https://explore.qore.network

# --- Relayer / deployer ---
# Pays for everything, deploys the contracts, and relays ballots. This is the
# ONLY account that needs funding from the faucet
# (https://dashboard.qorechain.io/faucet — sign-in required, 100 QOR per 24h);
# it then funds the trustees itself.
#
# Fund the `qor1…` form of THIS derivation. One mnemonic yields two different
# QoreChain accounts and only coin type 60 is the unified identity — see
# docs/VERIFIED-FACTS.md, "Funding and the two different qor1 addresses".
BOOTH_RELAYER_MNEMONIC=

# --- Trustees ---
# Each trustee's QoreSeal keys derive from its own mnemonic. In a real election
# a trustee never shares this with the app; here they are local so one script
# can play the whole panel.
BOOTH_TRUSTEE_1_MNEMONIC=
BOOTH_TRUSTEE_2_MNEMONIC=
BOOTH_TRUSTEE_3_MNEMONIC=

# --- Demo voters ---
# Each holds an ML-DSA-87 identity key and an EVM key from one mnemonic.
BOOTH_VOTER_1_MNEMONIC=
BOOTH_VOTER_2_MNEMONIC=
BOOTH_VOTER_3_MNEMONIC=
BOOTH_VOTER_4_MNEMONIC=
BOOTH_VOTER_5_MNEMONIC=

# --- Deployed contracts (filled in by the deploy scripts) ---
# Booth: the first iteration, with a client-side tally from revealed shares.
BOOTH_CONTRACT_ADDRESS=
# Election: the Foundry contract, with a k-of-n trustee tally submitted on chain.
ELECTION_CONTRACT_ADDRESS=

# --- Test switches ---
# Set to 1 to skip the tests that need the live testnet RPC.
# BOOTH_SKIP_LIVE=1
